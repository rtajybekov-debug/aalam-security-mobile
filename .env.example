# Локально: скопируйте в `.env`
# EAS Build: задайте те же переменные в https://expo.dev → проект → Environment variables
# (или `eas env:create`), чтобы в прод-сборку попали URL API и ключи карт.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=http://localhost:3000
EXPO_PUBLIC_MAPS_API_KEY_IOS=
EXPO_PUBLIC_MAPS_API_KEY_ANDROID=
# Optional: Sentry DSN for crash reporting. Leave empty to disable telemetry.
EXPO_PUBLIC_SENTRY_DSN=
